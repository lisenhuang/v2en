@page "/t/{id:long}"
@model PostModel
@{
    var titleEn = Model.TitleEnDisplay;
    ViewData["Title"] = titleEn;
    ViewData["Description"] = HtmlText.Preview(Model.Post.ContentEnHtml, 160);
    ViewData["Canonical"] = Model.Post.SourceUrl;

    const string labelToOriginal = "View original (中文)";
    const string labelToEnglish = "Show English translation";
}

<article id="post" class="post">
    <a class="back-link" href="/">← Home</a>

    <h1 class="post-detail-title">
        <span class="lang-en" lang="en">@titleEn</span>
        @if (Model.HasOriginal)
        {
            <span class="lang-zh" lang="zh-Hans">@Model.OriginalTitle</span>
        }
    </h1>

    <div class="post-meta">
        <span class="author">@Model.Post.AuthorName</span>
        <span class="dot">·</span>
        <time datetime="@Model.Post.Published.ToString("o")">@Model.Post.Published.UtcDateTime.ToString("yyyy-MM-dd HH:mm")Z</time>
    </div>

    @* Offered whenever the original has anything the English view doesn't — a title-only post counts,
       its title IS the post. Both sides below always render something, so the flip is never blank. *@
    @if (Model.HasOriginal)
    {
        <div class="post-lang">
            <button type="button"
                    id="lang-toggle"
                    class="lang-toggle"
                    data-label-to-original="@labelToOriginal"
                    data-label-to-english="@labelToEnglish">@labelToOriginal</button>
        </div>
    }

    <div class="post-content lang-en" lang="en">
        @if (Model.HasTranslatedBody)
        {
            @Html.Raw(Model.Post.ContentEnHtml)
        }
        else if (Model.IsTitleOnly)
        {
            <p class="post-empty">This post has no body — the title is the whole post.</p>
        }
        else
        {
            <p class="post-empty">No translated content is available for this post yet.</p>
        }
    </div>

    @if (Model.HasOriginal)
    {
        <div class="post-content lang-zh" lang="zh-Hans">
            @if (Model.HasOriginalBody)
            {
                @Html.Raw(Model.OriginalHtml)
            }
            else
            {
                <p class="post-empty">本主题没有正文，只有标题。</p>
            }
        </div>
    }

    <div class="post-footer">
        <a class="source-link" href="@Model.Post.SourceUrl" rel="nofollow noopener" target="_blank">View original on V2EX →</a>
    </div>
</article>
